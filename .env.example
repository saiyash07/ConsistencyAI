# CONSISTENCY AI uses a Bring-Your-Own-Key model.
# Users enter their Gemini / Groq keys in the Settings page; they are kept in
# browser memory only and are NEVER read from environment variables.
#
# No environment variables are required to run or deploy the app.
# Optional server-side tuning (all have defaults):

# Max request body size accepted by /api/* (bytes)
MAX_BODY_BYTES=200000
# Per-call timeout for outbound provider requests (ms)
PROVIDER_TIMEOUT_MS=25000
# Per-IP rate limit for /api/analyze: requests per minute (best effort, per instance)
RATE_LIMIT_PER_MINUTE=20
