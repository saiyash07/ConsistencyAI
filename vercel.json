{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": { "api/*.ts": { "maxDuration": 60 } },
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
